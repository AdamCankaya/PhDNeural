# Controlled cohorts are never downloaded by this image.
SKIP_ALZHEIMERS=1
SKIP_T2D=1

# Optional per-open-cohort NAS skips (default runs all three).
SKIP_BRCA_NAS=0
SKIP_RA_NAS=0
SKIP_EPIGENETIC_AGING_NAS=0

# CPU tuning. Keep workers at zero for tiny datasets / Windows bind mounts.
TORCH_NUM_THREADS=2
TOY_NAS_NUM_WORKERS=0

# Optional GitHub Repository Dispatch after a successful dashboard build.
# A repository_dispatch event alone does not guarantee a GitHub-mobile push;
# a GitHub Actions workflow must handle this event and issue any notification.
GITHUB_DISPATCH_ENABLED=0
GITHUB_REPOSITORY=
GITHUB_TOKEN=
GITHUB_DISPATCH_EVENT=bio_nas_toy_pipeline_complete
